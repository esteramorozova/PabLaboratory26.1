###
# 1) Odśwież tokeny (wklej wartości z poprzedniego 200 OK)
POST {{WebApi_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..85cp-h2PJl4PJeNX6gIhJvDIVVMt76LH8ecgovXg1tk",
  "refreshToken": "0+geQQudb9kgUvdltF27129IBaf6GKa2+PAaCGZMyi394LkCtAGjnyF6pXVJVpN+1GpbNfQ5wrgVV/g/vKD4pQ=="
}

###
# 2) Dane zalogowanego użytkownika (wklej accessToken)
GET {{WebApi_HostAddress}}/api/auth/me
Accept: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..GP0nIQrI8_AVoeOvvsLnEofeob_n1UoEtqV9cj3g740


###
# 3) Wylogowanie (odwołanie refresh tokenu)
POST {{WebApi_HostAddress}}/api/auth/revoke
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..GP0nIQrI8_AVoeOvvsLnEofeob_n1UoEtqV9cj3g740

"DHxx8W0mG/R99EbhGseqcDhuYtkvhgJyuO5RXIehooSKt+Dic/Yq8cNMz4R78Ezlx47c7SeTmH16mBYLtd2dJw=="
###
# 4) Kontakty (wymaga tokenu przez politykę ReadOnlyAccess)
GET {{WebApi_HostAddress}}/api/contacts
Accept: application/json
Authorization: Bearer {{accessToken}}

